---
import { capitalizeFirstLetter, getIntlLocale } from "@/content";
import { getLocale } from "@/i18n";

interface Props {
	date: Date;
	format?: "long" | "short";
}

const { date, format = "long" } = Astro.props;

const options: Intl.DateTimeFormatOptions =
	format === "long"
		? {
				weekday: "long",
				year: "numeric",
				month: "long",
				day: "numeric",
			}
		: {
				year: "numeric",
				month: "numeric",
				day: "numeric",
			};

const formattedDate = capitalizeFirstLetter(
	date.toLocaleDateString(getIntlLocale(getLocale(Astro.currentLocale)), options),
);
---

<span class="date">{formattedDate}</span>

<style>
	.date {
		/* font-family: var(--fontFamilySecondary); */
		color: var(--textColorSecondary);
		margin-bottom: var(--quarterSpacing);
	}
</style>
