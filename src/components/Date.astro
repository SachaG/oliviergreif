---
import { capitalizeFirstLetter, getIntlLocale } from "@/content";
import { getLocale } from "@/i18n";

interface Props {
	date: Date;
	format?: "long" | "short";
	// optional 24-hour "HH:MM" time, shown with the date in the locale's format
	time?: string;
}

const { date, format = "long", time } = Astro.props;

const options: Intl.DateTimeFormatOptions =
	format === "long"
		? {
				weekday: "long",
				year: "numeric",
				month: "long",
				day: "numeric",
			}
		: {
				year: "numeric",
				month: "numeric",
				day: "numeric",
			};

const [hours, minutes] = (time || "").split(":").map(Number);
const hasTime = time !== undefined && !isNaN(hours) && !isNaN(minutes);
const dateTime = new globalThis.Date(date);
if (hasTime) {
	dateTime.setHours(hours, minutes);
}

// e.g. "Vendredi 6 novembre 2026 à 19:00" / "Friday, November 6, 2026 at 7:00 PM"
const formattedDate = capitalizeFirstLetter(
	dateTime.toLocaleString(
		getIntlLocale(getLocale(Astro.currentLocale)),
		hasTime ? { ...options, hour: "numeric", minute: "2-digit" } : options,
	),
);
---

<span class="date">{formattedDate}</span>

<style>
	.date {
		/* font-family: var(--fontFamilySecondary); */
		color: var(--textColorSecondary);
		margin-bottom: var(--quarterSpacing);
	}
</style>
