---
import { getConcert, getSectionPath, SectionId } from "@/content";
import CatalogueRelated from "@components/catalogue/CatalogueRelated.astro";
import Date from "@components/Date.astro";
import Field from "@components/Field.astro";
import PageLayout from "@components/layouts/PageLayout.astro";
import T from "@components/T.astro";
import Link from "@components/Link.astro";

const { id, variant = "full" } = Astro.props;
const concert = getConcert(id);

const { interpretes, adresse, date, heure, titre, commentaire, oeuvres } =
	concert;
const showFull = variant === "full";
---

<PageLayout
	sectionId={SectionId.CONCERTS}
	parentPath={getSectionPath(SectionId.CONCERTS)}
>
	<div slot="page-heading">
		<h3 class="subheading">
			<!-- <Link href={getSectionPath(SectionId.CONCERTS)}>
				<T k="concerts" />
			</Link>{" "} -->
			<!-- / -->
			<Date date={date} time={heure} />
		</h3>
		<h2>{titre}</h2>
	</div>
	<div slot="page-content">
		<table>
			<tbody>
				{showFull && <Field k="concerts.adresse">{adresse}</Field>}
				<Field k="concerts.interpretes">{interpretes}</Field>
				{oeuvres && oeuvres.length > 0 && (
					<Field k="concerts.oeuvres">
						<CatalogueRelated oeuvres={oeuvres} />
					</Field>
				)}
				{commentaire && (
					<Field k="concerts.commentaire">
						<div set:html={commentaire} />
					</Field>
				)}
			</tbody>
		</table>
	</div>
</PageLayout>
