---
const { className } = Astro.props;
---

<section class={`subcontainer subgrid-layout ${className}`}>
	<div class="col1">
		<div class="subgrid-heading">
			<slot name="col1" />
		</div>
	</div>
	<div class="main">
		<slot name="main" />
	</div>
</section>

<style lang="scss" type="text/scss">
	@use "../../styles/_breakpoints.scss" as *;
	.subgrid-layout {
		@include breakpointOver(lg) {
			display: grid;
			grid-template-columns: subgrid;
			grid-column: 1/-1;
		}
	}

	.col1 {
		border-right: var(--border);
		padding-right: var(--doubleSpacing);
	}

	.catalogue-year:not(:has(.catalogue-oeuvre.visible)) {
		display: none;
	}

	.subgrid-heading {
		@include breakpointUnder(lg) {
			margin-bottom: var(--spacing);
		}
		@include breakpointOver(lg) {
			position: sticky;
			top: 10px;
		}
	}

	.main {
		display: flex;
		flex-direction: column;
		gap: var(--spacing);
	}
</style>
