---
import { getSection2, SectionId } from "@/content";
import T from "@components/T.astro";
import Link from "@components/Link.astro";
import LanguageSwitcher from "@components/LanguageSwitcher.astro";
import type { Locale } from "@/i18n";
import { getSectionIcon } from "@/icons";
import ArrowIcon from "@components/icons/ArrowIcon.astro";

interface Props {
	sectionId?: SectionId;
	parentPath?: string;
	hasSidebar?: boolean;
	// only needed on pages without a locale in their URL (404)
	locale?: Locale;
	showLanguageSwitcher?: boolean;
}

const {
	sectionId,
	parentPath,
	locale,
	showLanguageSwitcher = true,
} = Astro.props;

const sidebarSlotContent = (await Astro.slots.render("page-sidebar")) || "";
const hasSidebar = sidebarSlotContent.trim().length > 0;

const defaultSlotContent = (await Astro.slots.render("page-heading")) || "";
const hasContent = defaultSlotContent.trim().length > 0;

const SectionIcon = sectionId ? getSectionIcon(sectionId) : undefined;
---

<div
	class={`page page-${hasSidebar ? "withSidebar" : "noSidebar"}`}
	style={
		sectionId ? `view-transition-name: section-${sectionId};` : undefined
	}
>
	<div class="page-heading">
		<div class="page-heading-breadcrumbs">
			<Link class="home-link" href="/" locale={locale}>
				<ArrowIcon />
				<span class="visually-hidden">
					<T k="retour_accueil" locale={locale} />
				</span>
			</Link>

			{parentPath && (
				<Link
					class="home-link"
					href={parentPath || "/"}
					locale={locale}
				>
					{SectionIcon && <SectionIcon />}

					<T k={sectionId} locale={locale} hidden={true} />
				</Link>
			)}
		</div>
		<div class="page-heading-content">
			{hasContent ? (
				<slot name="page-heading" />
			) : (
				<h2 style={`view-transition-name: heading-${sectionId}`}>
					<T k={sectionId} locale={locale} />
				</h2>
			)}
		</div>
		{showLanguageSwitcher && (
			<div class="page-heading-language">
				<LanguageSwitcher />
			</div>
		)}
	</div>
	<div class="page-content grid">
		<main class="page-main">
			<slot name="page-content" />
		</main>
		<div class="page-sidebar">
			<div class="sidebar-contents">
				<slot name="page-sidebar" />
			</div>
		</div>
	</div>
</div>

<style lang="scss" is:global>
	@use "@styles/_breakpoints.scss" as *;

	.page {
		min-height: 100vh;
		display: grid;
		grid-template-rows: 130px 1fr;
	}
	.page-heading {
		display: grid;
		grid-template-columns: min-content 1fr auto;
		border-bottom: var(--border);
		@include breakpointUnder(lg) {
			grid-template-columns: 60px 1fr auto;
		}
	}
	.page-heading-breadcrumbs {
		display: flex;
	}
	.page-heading-language {
		display: grid;
		place-items: center;
		padding: 0 var(--doubleSpacing);
		@include breakpointUnder(lg) {
			padding: 0 var(--spacing);
		}
	}
	.home-link {
		display: grid;
		place-items: center;
		font-size: 8rem;
		text-decoration: none;
		border-right: var(--border);
		vertical-align: middle;
		&:hover {
			background-color: var(--textColor);
			color: var(--bgColor);
		}
		.arrow {
			text-box-edge: cap alphabetic;
			text-box-trim: trim-both;
		}
		@include breakpointUnder(lg) {
			font-size: 2rem;
		}
		@include breakpointOver(lg) {
			aspect-ratio: 1/1;
		}
	}

	.page-heading-content {
		// position: sticky;
		// top: 10px;
		// background-color: var(--bgColor);
		z-index: 100;
		padding: var(--spacing);
		display: flex;
		flex-direction: column;
		justify-content: center;
		a {
			color: var(--textColor);
			text-decoration: none;
		}
		h2 {
			font-size: 1.6rem;
			@include breakpointUnder(lg) {
				font-size: 1.4rem;
			}
		}
	}
	.heading {
		margin-bottom: var(--spacing);
	}
	.page-main {
		padding: var(--doubleSpacing);
		display: flex;
		flex-direction: column;
		gap: var(--doubleSpacing);
		.page-withSidebar & {
			border-right: var(--border);
			padding-right: var(--doubleSpacing);
		}
		.subgrid-layout {
			padding-bottom: var(--doubleSpacing);
			border-bottom: var(--border);
		}
	}

	.page-sidebar {
		padding: var(--doubleSpacing);
		position: sticky;
		top: 10px;
	}

	.sidebar-contents {
		display: flex;
		flex-direction: column;
		gap: var(--doubleSpacing);
	}
	.sidebar-block-heading {
		margin-bottom: var(--halfSpacing);
	}
</style>
