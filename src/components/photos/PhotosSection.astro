---
import { getPhotos, SectionId } from "../../content";
import Photo from "./Photo.astro";

const photos = getPhotos();
---

<section>
	<div class="photos-section">
		{photos.slice(0, 6).map(({ id }) => (
			<Photo id={id} />
		))}
	</div>
</section>

<style>
	.photos-section {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--spacing);
	}
</style>
