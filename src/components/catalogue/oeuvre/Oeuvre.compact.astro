---
import { getOeuvre } from "@/content";
import { convertTitle, getPath } from "@/content";
import FeedItemHeading from "@components/FeedItemHeading.astro";
import Instruments from "@components/catalogue/oeuvre/Instruments.astro";
import T from "@components/T.astro";
const { id } = Astro.props;
const oeuvre = getOeuvre(id);
const {
	opus,
	titre,
	instruments = [],
	// editeur,
	// texte,
	// creation,
	// duree,
} = oeuvre;

const className = instruments
	?.map((i) => `instrument-${convertTitle(i)}`)
	.join(" ");
---

<div
	data-titre={titre}
	class={`search-item catalogue-oeuvre visible ${className}`}
>
	<div class="opus"><T k="catalogue.opus" /> {opus}</div>
	<FeedItemHeading path={getPath(oeuvre)} content={titre} />

	<main>
		<Instruments oeuvre={oeuvre} />
	</main>
</div>

<style lang="scss" type="text/scss">
	.opus {
		text-transform: uppercase;
		color: var(--textColorSecondary);
		margin-bottom: var(--eighthSpacing);
	}

	h3 {
		margin-bottom: var(--quarterSpacing);
	}
	a {
		text-decoration: none;
	}
</style>
