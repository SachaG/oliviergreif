---
import SidebarBlock from "../SidebarBlock.astro";
import { getString } from "../../content";
import { getLocale } from "../../i18n";

const locale = getLocale(Astro.currentLocale);
---

<SidebarBlock k="catalogue.rechercher">
	<input
		id="searchInput"
		name="search"
		type="text"
		aria-label={getString("catalogue.rechercher", { locale }).t}
	/>
</SidebarBlock>

<style>
	input {
		background: none;
		border-radius: 0;
		border: var(--border);
		padding: var(--quarterSpacing);
		font-family: var(--fontFamilySecondary);
	}
</style>
