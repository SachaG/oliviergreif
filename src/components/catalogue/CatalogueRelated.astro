---
import { getPath, getOeuvreByReference } from "@/content";
import type { OeuvreReference } from "@/types";
import LinkItem from "@components/LinkItem.astro";
import compact from "lodash/compact.js";

interface Props {
	oeuvres?: OeuvreReference[];
}

const oeuvres = compact(Astro.props.oeuvres?.map(getOeuvreByReference));
---

{
	oeuvres && oeuvres.length > 0 ? (
		<div>
			<ul class="items-list">
				{oeuvres.map((oeuvre) => (
					<li>
						<LinkItem
							path={getPath(oeuvre)}
							content={oeuvre?.titre}
						/>
					</li>
				))}
			</ul>
		</div>
	) : null
}
