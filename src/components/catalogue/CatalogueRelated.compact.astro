---
import { getPath, getOeuvreByReference } from "../../content";
import type { OeuvreReference } from "../../types";
import LinkItem from "../LinkItem.astro";

interface Props {
	oeuvres: OeuvreReference[];
}
const { oeuvres } = Astro.props;
---

<div>
	<ul class="items-list">
		{
			oeuvres.map((reference) => {
				const { id } = reference;
				const oeuvre = getOeuvreByReference(reference);

				return oeuvre ? (
					<li>
						<LinkItem
							path={getPath(oeuvre)}
							content={oeuvre.titre}
						/>
					</li>
				) : (
					<li class="missing-link">{id}</li>
				);
			})
		}
	</ul>
</div>

<style></style>
