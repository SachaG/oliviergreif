---
import { getCatalogue, getSectionPath, SectionId } from "@/content";
import LinkItem from "@components/LinkItem.astro";
import T from "@components/T.astro";
import Categories from "@components/catalogue/Categories.astro";
import Instruments from "@components/catalogue/Instruments.astro";

const catalogue = getCatalogue();
---

<div class="catalogue-section">
	<!-- <div class="catalogue-all">
		<ul class="items-list">
			<li>
				<LinkItem path={getSectionPath(SectionId.CATALOGUE)}>
					<T k="toutes_les_oeuvres" />{" "}
					<span class="count">({catalogue.length})</span>
				</LinkItem>
			</li>
		</ul>
	</div> -->
	<div class="catalogue-categories">
		<Categories limit={7} enableShowMore={false} />
		<Instruments limit={7} enableShowMore={false} />
	</div>
	<!-- <div class="home-section-link">
		<a href={getSectionPath((SectionId.CATALOGUE))}>Voir plus…</a>
	</div> -->
</div>

<style lang="scss" is:global>
	@use "@styles/_breakpoints.scss" as *;
	.catalogue-section {
		display: flex;
		flex-direction: column;
		gap: var(--spacing);
	}
	.catalogue-categories {
		@include breakpointUnder(lg) {
			display: flex;
			flex-direction: column;
			gap: var(--spacing);
		}
		@include breakpointOver(lg) {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: var(--doubleSpacing);
		}
	}
	.count {
		font-weight: normal;
	}
	ul.items-list {
		.link-heading {
			font-size: 0.9rem;
		}
	}
</style>
