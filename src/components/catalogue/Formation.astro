---
import { convertTitle } from "../../content";
import Link from "../Link.astro";

const { formation, currentFormationId } = Astro.props;
const isCurrent = convertTitle(formation) === currentFormationId;
---

<li class={isCurrent ? "formation-current" : ""}>
	<Link href={`/catalogue/formations/${convertTitle(formation)}`}>{formation}</Link>
</li>

<style>
	.formation-current {
		a {
			font-weight: bold;
		}
	}
</style>
