---
import { fade, slide } from "astro:transitions";
import T from "../T.astro";
import {
	getSectionPath,
	customTransition,
	getSectionComponent,
} from "../../content";
import Link from "../Link.astro";
import PlusIcon from "../icons/PlusIcon.astro";
const { sectionId, color, inverted } = Astro.props;

const SectionComponent = getSectionComponent(sectionId);
---

<section
	class={`home-section home-section-active section-${sectionId} section-${inverted ? "inverted" : "normal"}`}
	style={`view-transition-name: section-${sectionId}`}
>
	<div class="home-section-inner">
		<h2
			class="home-section-heading"
			style={`view-transition-name: heading-${sectionId}`}
			data-transition-name={`heading-${sectionId}`}
		>
			<Link
				class="section-link link-heading"
				href={getSectionPath(sectionId)}
			>
				<T k={sectionId} />
			</Link>
		</h2>
		<div class="home-section-contents">
			{SectionComponent ? <SectionComponent /> : null}
		</div>

		<div class="home-section-footer">
			<Link
				class="home-section-expand"
				href={getSectionPath(sectionId)}
				data-transition-name={`heading-${sectionId}`}
			>
				<PlusIcon />
				<T k="voir_plus" hidden={true} />
			</Link>
		</div>
	</div>
</section>

<style lang="scss" is:global define:vars={{ sectionId, color, inverted }}>
	.home-section {
		view-transition-name: var(--sectionId);
		grid-area: var(--sectionId);
		background-color: var(--color);
		background-color: var(--bgColor);

		/* border: 2px solid var(--borderColor); */
		position: relative;
		background: var(--bgColor);

		&.home-section-active:hover {
			background: var(--bgColorSecondary);
		}

		/* a,
		a:link,
		a:visited {
			color: var(--textColor);
		} */
		section {
			display: flex;
			flex-direction: column;
			justify-content: space-between;
			gap: var(--spacing);
		}
	}

	.home-section-inner {
		display: grid;
		grid-template-rows: min-content 1fr min-content;
		height: 100%;
	}
	.home-section-heading {
		margin: 0;
		a {
			padding: var(--halfSpacing) var(--spacing);
			text-transform: uppercase;
			font-size: 1rem;
			// margin-bottom: var(--spacing);
			border-bottom: var(--border);
			text-decoration: none;
			&:hover {
				background: rgba(255, 255, 255, 0.1);
				border-color: var(--linkHoverColor);
			}
		}
	}
	.home-section-contents {
		padding: var(--spacing);
	}
	.home-section-footer {
		display: flex;
		justify-content: flex-end;
	}
	.home-section-expand {
		border-top: var(--border);
		border-left: var(--border);
		padding: 10px;
		svg {
			height: 24px;
			width: 24px;
		}
		&:hover {
			border-color: var(--linkHoverColor);
			svg {
				color: var(--linkHoverColor);
			}
		}
	}
	.section-inverted {
		a {
			color: var(--invertedTextColor);
		}
		&:hover a {
			color: var(--invertedHoverTextColor);
		}
	}
	.home-section-link {
		font-size: 0.9rem;
	}
</style>
