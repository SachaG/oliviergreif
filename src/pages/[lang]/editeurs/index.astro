---
import Editeur from "../../../components/editeurs/Editeur.compact.astro";
import PageLayout from "../../../components/layouts/PageLayout.astro";
import { getEditeurs, getString, SectionId } from "../../../content";

import Layout from "../../../layouts/Layout.astro";
import { getLocale, getLocaleStaticPaths } from "../../../i18n";

export const getStaticPaths = () => getLocaleStaticPaths();

const locale = getLocale(Astro.currentLocale);
---

<Layout title={getString("editeurs", { locale })?.t}>
	<PageLayout sectionId={SectionId.EDITEURS}>
		{
			getEditeurs().map((editeur) => (
				<Editeur slot="page-content" id={editeur.id} />
			))
		}
	</PageLayout>
</Layout>
