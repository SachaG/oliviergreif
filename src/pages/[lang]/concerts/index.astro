---
import Concert from "../../../components/concerts/Concert.compact.astro";
import PageLayout from "../../../components/layouts/PageLayout.astro";
import SubgridLayout from "../../../components/layouts/SubgridLayout.astro";
import {
	getConcerts,
	getItemsByYear,
	customTransition,
	getSection2,
	getString,
	SectionId,
} from "../../../content";
import { fade, slide } from "astro:transitions";

import Layout from "../../../layouts/Layout.astro";
import type { ConcertWithId } from "../../../types";
import ConcertsSearch from "../../../components/concerts/ConcertsSearch.astro";
import { getLocale, getLocaleStaticPaths } from "../../../i18n";

export const getStaticPaths = () => getLocaleStaticPaths();

const concerts = getConcerts();
const concertsByYear = getItemsByYear<ConcertWithId>(concerts);
const sectionId = SectionId.CONCERTS;

const locale = getLocale(Astro.currentLocale);
---

<script src="../../../scripts/search.ts"></script>

<Layout title={getString("concerts", { locale })?.t}>
	<PageLayout sectionId={sectionId}>
		{
			concertsByYear.map((yearItem) => (
				<SubgridLayout slot="page-content">
					<div slot="col1">
						<h4>{yearItem.year}</h4>
					</div>
					<div class="feed-items" slot="main">
						{yearItem.items.map((concert) => (
							<Concert id={concert.id} />
						))}
					</div>
				</SubgridLayout>
			))
		}
		<ConcertsSearch slot="page-sidebar" />
	</PageLayout>
</Layout>

<style>
	.section-concerts {
		background: pink;
	}
</style>
