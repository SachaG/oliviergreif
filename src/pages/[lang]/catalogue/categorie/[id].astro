---
import Oeuvre from "@components/catalogue/oeuvre/Oeuvre.compact.astro";
import {
	capitalizeFirstLetter,
	getCategories,
	getInstrumentsGroups,
	getString,
	instrumentGroups,
	SectionId,
	convertTitle,
	getCatalogue,
	getSection2,
	getSectionPath,
} from "@/content";
import Layout from "@layouts/Layout.astro";
import type { WithSlug } from "@/types";
import Instruments from "@components/catalogue/Instruments.astro";
import SubgridLayout from "@components/layouts/SubgridLayout.astro";
import SubgridWrapper from "@components/layouts/SubgridWrapper.astro";
import T from "@components/T.astro";
import PageLayout from "@components/layouts/PageLayout.astro";
import Categories from "@components/catalogue/Categories.astro";
import AllCatalog from "@components/catalogue/AllCatalog.astro";
import Editeurs from "@components/catalogue/Editeurs.astro";
import Search from "@components/catalogue/Search.astro";
import { getItemIdFromSlug, getItemsStaticPaths } from "@/helpers";
import { getLocale } from "@/i18n";
import { byNumberOfInstruments } from "@/helpers";

const { id } = Astro.params;
const categoryId = getItemIdFromSlug(id as string);

export function getStaticPaths() {
	const staticPaths = getItemsStaticPaths(
		getCategories().map(({ id }) => ({ id: convertTitle(id) }) as WithSlug),
	);
	return staticPaths;
}

const catalogue = getCatalogue({ categoryId });
const title = categoryId || "";

const catalogueByNumberOfInstruments = byNumberOfInstruments(catalogue);

const locale = getLocale(Astro.currentLocale);
---

<script src="@scripts/search.ts"></script>

<Layout
	title={`${getString("catalogue", { locale })?.t} (${getString(categoryId, { locale, fallback: capitalizeFirstLetter(title) }).t})`}
>
	<PageLayout
		sectionId={SectionId.CATALOGUE}
		parentPath={getSectionPath(SectionId.CATALOGUE)}
	>
		<h2
			slot="page-heading"
			style={`view-transition-name: heading-catalogue`}
		>
			<T k="catalogue.categorie" />:{" "}
			<T k={categoryId} fallback={capitalizeFirstLetter(title)} /> (
			{catalogue.length}{" "}
			<T k="oeuvre" kPlural="oeuvres" count={catalogue.length} />)
		</h2>
		<SubgridWrapper slot="page-content">
			{catalogueByNumberOfInstruments.map(({ count, items }) => (
				<SubgridLayout>
					<h4 class="count-title" slot="col1">
						<span class="count-heading">
							{count}{" "}
							<T
								k="instrument"
								kPlural="instruments"
								count={count}
							/>
							{/* <span>
										({items.length}{" "}
										{pluralize("œuvre", items.length)})
									</span> */}
						</span>
					</h4>
					<div class="feed-items" slot="main">
						{items.map((oeuvre) => (
							<Oeuvre id={oeuvre.id} />
						))}
					</div>
				</SubgridLayout>
			))}
		</SubgridWrapper>
		<AllCatalog slot="page-sidebar" />
		<Search slot="page-sidebar" />
		<Categories slot="page-sidebar" currentCategoryId={categoryId} />
		<Instruments slot="page-sidebar" />
		<Editeurs slot="page-sidebar" />
	</PageLayout>
</Layout>

<style lang="scss" type="text/scss">
	.instruments-list {
		display: flex;
		gap: var(--halfSpacing);
	}
	.count-heading {
		white-space: nowrap;
	}
</style>
