---
import Oeuvre from "../../../../components/catalogue/oeuvre/Oeuvre.compact.astro";
import AllCatalog from "../../../../components/catalogue/AllCatalog.astro";
import {
	capitalizeFirstLetter,
	getInstrumentsGroups,
	getString,
	instrumentGroups,
	SectionId,
	convertTitle,
	getCatalogue,
	getSectionPath,
} from "../../../../content";
import Layout from "../../../../layouts/Layout.astro";
import type { WithSlug } from "../../../../types";
import Instruments from "../../../../components/catalogue/Instruments.astro";
import SubgridLayout from "../../../../components/layouts/SubgridLayout.astro";
import T from "../../../../components/T.astro";
import PageLayout from "../../../../components/layouts/PageLayout.astro";
import Categories from "../../../../components/catalogue/Categories.astro";
import Editeurs from "../../../../components/catalogue/Editeurs.astro";
import Search from "../../../../components/catalogue/Search.astro";
import { getItemsStaticPaths } from "../../../../helpers";
import { getLocale } from "../../../../i18n";
import SubgridWrapper from "../../../../components/layouts/SubgridWrapper.astro";
import { byNumberOfInstruments } from "../../../../helpers";

const { id } = Astro.params;
const instrumentGroupId = id as keyof typeof instrumentGroups;

export function getStaticPaths() {
	return getItemsStaticPaths(
		getInstrumentsGroups().map(
			({ id }) => ({ id: convertTitle(id) }) as WithSlug,
		),
	);
}

const instruments = instrumentGroups[instrumentGroupId];
const catalogue = getCatalogue({ instrumentGroupId });
const title = instrumentGroupId || "";

const catalogueByNumberOfInstruments = byNumberOfInstruments(catalogue);

const locale = getLocale(Astro.currentLocale);
---

<script src="../../../../scripts/search.ts"></script>

<script>
	import { convertTitle } from "../../../../helpers";

	// Find our component DOM on the page.
	const checkboxes =
		document.querySelectorAll<HTMLInputElement>(".instrument-toggle");

	// Add event listeners to fire confetti when a button is clicked.
	checkboxes.forEach((checkbox) => {
		checkbox.addEventListener("click", () => {
			// Get the checked/unchecked status
			const isChecked = checkbox.checked;

			// Get the value of the data-filter attribute
			const instrument = checkbox.getAttribute("data-instrument");
			const oeuvres = document.querySelectorAll<HTMLDivElement>(
				`.instrument-${convertTitle(instrument || "")}`,
			);

			if (isChecked) {
				oeuvres.forEach((oeuvre) => {
					oeuvre.classList.add("visible");
					oeuvre.classList.remove("hidden");
				});
			} else {
				oeuvres.forEach((oeuvre) => {
					oeuvre.classList.add("hidden");
					oeuvre.classList.remove("visible");
				});
			}
		});
	});
</script>

<Layout
	title={`${getString("catalogue", { locale })?.t} (${getString(instrumentGroupId, { locale, fallback: capitalizeFirstLetter(title) }).t})`}
>
	<PageLayout
		sectionId={SectionId.CATALOGUE}
		parentPath={getSectionPath(SectionId.CATALOGUE)}
	>
		<h2
			slot="page-heading"
			style={`view-transition-name: heading-catalogue`}
		>
			<T k="catalogue.instrument" />:{" "}
			<T k={instrumentGroupId} fallback={capitalizeFirstLetter(title)} />{" "}
			({catalogue.length}{" "}
			<T k="oeuvre" kPlural="oeuvres" count={catalogue.length} />)
		</h2>
		<div slot="page-content">
			{instruments.length > 1 && (
				<div class="instruments-filter">
					{instruments.map((instrument) => (
						<h5>
							<label class="instruments-filter-item">
								<input
									class="instrument-toggle"
									type="checkbox"
									checked="checked"
									data-instrument={instrument}
								/>
								<span>
									<T k={`instruments.${instrument}`} />
								</span>
							</label>
						</h5>
					))}
				</div>
			)}
		</div>
		<SubgridWrapper slot="page-content">
			{catalogueByNumberOfInstruments.map(({ count, items }) => (
				<SubgridLayout>
					<h4 class="count-title" slot="col1">
						<span class="count-heading">
							{count}{" "}
							<T
								k="instrument"
								kPlural="instruments"
								count={count}
							/>
							{/* <span>
										({items.length}{" "}
										{pluralize("œuvre", items.length)})
									</span> */}
						</span>
					</h4>
					<div class="feed-items" slot="main">
						{items.map((oeuvre) => (
							<Oeuvre id={oeuvre.id} />
						))}
					</div>
				</SubgridLayout>
			))}
		</SubgridWrapper>
		<AllCatalog slot="page-sidebar" />
		<Search slot="page-sidebar" />
		<Categories slot="page-sidebar" />
		<Instruments
			slot="page-sidebar"
			currentInstrumentId={instrumentGroupId}
		/>
		<Editeurs slot="page-sidebar" />
	</PageLayout>
</Layout>

<style lang="scss" type="text/scss">
	// .count-title {
	// 	position: sticky;
	// 	top: 0px;
	// 	font-size: 1.6rem;
	// }
	.instruments-filter {
		display: flex;
		gap: var(--spacing);
		flex-wrap: wrap;
		border: 1px solid var(--borderColor);
		padding: var(--halfSpacing);
	}
	.count-heading {
		white-space: nowrap;
	}
	.instruments-filter-item {
		display: flex;
		justify-content: center;
		gap: var(--halfSpacing);
		input {
			accent-color: var(--textColor);
		}
	}
</style>
