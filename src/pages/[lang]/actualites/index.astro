---
import Actualite from "../../../components/actualites/Actualite.compact.astro";
import PageLayout from "../../../components/layouts/PageLayout.astro";
import {
	getActualites,
	getConcerts,
	getString,
	SectionId,
} from "../../../content";
import Layout from "../../../layouts/Layout.astro";
import { getLocale, getLocaleStaticPaths } from "../../../i18n";

export const getStaticPaths = () => getLocaleStaticPaths();

const actualites = getActualites();

const locale = getLocale(Astro.currentLocale);
---

<Layout title={getString("actualites", { locale })?.t}>
	<PageLayout sectionId="actualites">
		{
			actualites.map(({ id }) => (
				<div slot="page-content">
					<Actualite id={id} />
				</div>
			))
		}
	</PageLayout>
</Layout>
