---
import PageLayout from "@components/layouts/PageLayout.astro";
import Photo from "@components/photos/Photo.astro";
import { getPhotos, SectionId } from "@/content";
import { getString } from "@/content";
import Layout from "@layouts/Layout.astro";
import { getLocale, getLocaleStaticPaths } from "@/i18n";

export const getStaticPaths = () => getLocaleStaticPaths();

const photos = getPhotos();

const locale = getLocale(Astro.currentLocale);
---

<Layout title={getString("photos", { locale })?.t}>
	<PageLayout sectionId={SectionId.PHOTOS}>
		<div class="photos-section" slot="page-content">
			{photos.map(({ id }) => <Photo id={id} />)}
		</div>
	</PageLayout>
</Layout>

<style>
	.photos-section {
		display: grid;
		grid-template-columns: 1fr 1fr 1fr 1fr;
		gap: var(--spacing);
	}
</style>
