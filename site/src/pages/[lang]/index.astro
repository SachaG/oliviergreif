---
import Layout from "@layouts/Layout.astro";
// import HomeBlock from "@components/HomeBlock.astro";
import { sections } from "@/content";
import HomeSection from "@components/home/HomeSection.astro";
import Footer from "@components/Footer.astro";
import Title from "@components/home/Title.astro";
import { getLocaleStaticPaths } from "@/i18n";

export const getStaticPaths = () => getLocaleStaticPaths();
---

<Layout>
	<div class="home-sections">
		<Title />
		{sections
			.filter((s) => s.showOnHome)
			.map((section) => (
				<HomeSection sectionId={section.id} {...section} />
			))}
		<Footer />
	</div>
</Layout>

<style lang="scss" is:global>
	@use "@styles/_breakpoints.scss" as *;

	.home-sections {
		background: var(--borderColor);
		background: #6aab9c;
		height: 100vh;
		width: 100vw;
		gap: 5px;
		@include breakpointUnder(lg) {
			display: flex;
			flex-direction: column;
		}
		@include breakpointOver(lg) {
			display: grid;
			grid-template-columns: repeat(6, 1fr);
			grid-template-rows: 1fr 1fr 1fr;
			/* grid-template-areas:
			"title title title concerts concerts actualites "
			"catalogue catalogue biographie biographie disques media"
			"catalogue catalogue editeurs association liens contact"
			"footer footer footer footer footer footer"; */
			grid-template-areas:
				"title title title biographie biographie concerts "
				"catalogue catalogue disques disques photos actualites"
				" catalogue catalogue disques disques photos footer";
		}
	}

	.section-footer {
		view-transition-name: footer;
		grid-area: footer;
		padding: 0;
	}
</style>
