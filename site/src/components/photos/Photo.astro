---
import { getPath, getPhoto, getPhotoThumbnailUrl } from "@/content";
import Link from "@components/Link.astro";

const { id } = Astro.props;

const photo = getPhoto(id);
const { titre } = photo;
---

<Link class="thumbnail" href={getPath(photo)}
	><img alt={titre} src={getPhotoThumbnailUrl(photo)} /></Link
>

<style lang="scss">
	img {
		aspect-ratio: 1/1;
		object-fit: cover;
	}
</style>
