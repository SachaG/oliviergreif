---
import { getConcerts, getPath } from "@/content";
import Date from "@components/Date.astro";
import FeedItemHeading from "@components/FeedItemHeading.astro";
import { getLocale } from "@/i18n";

const locale = getLocale(Astro.currentLocale);

// local midnight today, so concerts happening today still count as upcoming
const today = new globalThis.Date();
today.setHours(0, 0, 0, 0);

// getConcerts is newest first: the next upcoming concert is the last one not
// yet past; fall back to the most recent concert if none is scheduled
const concerts = getConcerts(locale).filter((c) => !isNaN(c.date.getTime()));
const concert = concerts.findLast((c) => c.date >= today) ?? concerts.at(0)!;

const { date, titre } = concert;
---

<section>
	<div class="concerts-section-contents">
		<Date date={date} format="short" />
		<FeedItemHeading path={getPath(concert)} content={titre} />
	</div>
</section>

<style lang="scss">
	h3 {
		font-size: 0.9rem;
	}
</style>
