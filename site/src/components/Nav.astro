---
import T from "@components/T.astro";
import Link from "@components/Link.astro";
const links = [
	{ k: "accueil", path: "/" },
	{ k: "catalogue", path: "/catalogue" },
	{ k: "concerts", path: "/concerts" },
	{ k: "disques", path: "/disques" },
	{ k: "editeurs", path: "/editeurs" },
	{ k: "actualites", path: "/actualites" },
	{ k: "biographie", path: "/biographie" },
	{ k: "association", path: "/association" },
	{ k: "media", path: "/media" },
	{ k: "liens", path: "/liens" },
	{ k: "contact", path: "/contact" },
];
---

<ul class="nav">
	{
		links.map(({ k, path }) => (
			<li>
				<Link href={path}>
					<T k={k} />
				</Link>
			</li>
		))
	}
</ul>

<style lang="scss" is:global>
	.nav {
		display: flex;
		list-style-type: none;
		gap: 20px;
		padding: 0;
		margin: 0;
	}
</style>
