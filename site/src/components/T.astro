---
import { getString } from "@/content";
import { getLocale, type Locale } from "@/i18n";

interface Props {
	k?: string;
	kPlural?: string;
	count?: number;
	fallback?: string;
	// override the current locale (e.g. on the 404 page)
	locale?: Locale;
	hidden?: boolean;
}

const { k = "", kPlural, count, fallback, hidden = false } = Astro.props;
const locale = Astro.props.locale ?? getLocale(Astro.currentLocale);
const { t } = getString(k, { locale, kPlural, count, fallback });
const classes = ["t"];
if (hidden) {
	classes.push("visually-hidden");
}
---

<span class={classes.join(" ")} data-key={k}>
	{t || fallback || k}
</span>
