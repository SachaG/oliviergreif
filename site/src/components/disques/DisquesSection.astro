---
import { getDisques, getPath, getSectionPath, SectionId } from "@/content";
import T from "@components/T.astro";
import DisqueCover from "@components/disques/DisqueCover.astro";
import Link from "@components/Link.astro";

const disques = getDisques();
---

<section>
	<div class="disques-section contents">
		{disques
			.filter((disque) => disque.image)
			.slice(0, 6)
			.map((disque) => (
				<DisqueCover id={disque.id} />
			))}
	</div>
</section>

<style>
	.contents {
		display: grid;
		grid-template-columns: 1fr 1fr 1fr;
		gap: var(--spacing);
	}
	ul {
		list-style-type: none;
		margin: 0;
		padding: 0;
	}
</style>
