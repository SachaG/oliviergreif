---
import { getSectionPath, SectionId } from "@/content";
import { Content as BioFr } from "@content/biographie.excerpt.fr.md";
import { Content as BioEn } from "@content/biographie.excerpt.en.md";
import T from "@components/T.astro";
import { getLocale } from "@/i18n";
import Link from "@components/Link.astro";

const locale = getLocale(Astro.currentLocale);
const Bio = locale === "en" ? BioEn : BioFr;
---

<section>
	<div class="biographie-section-contents">
		<Bio />
	</div>
	<!-- 
	<Link
		class="home-section-link link-heading"
		href={getSectionPath(SectionId.BIOGRAPHIE)}><T k="lire_la_suite" /></Link
	> -->
</section>

<style>
	.biographie-section-contents {
		margin-bottom: var(--halfSpacing);
	}
</style>
